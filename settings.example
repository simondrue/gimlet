# gimlet settings. Changes apply at the next menu refresh.

# Your GenomeDK login and the Slurm account (project) jobs are billed to.
USERNAME=
ACCOUNT=
# Leave empty to use the default partition.
PARTITION=

LOGIN_HOST=login.genome.au.dk
IDENTITY_FILE=~/.ssh/id_ed25519

# Time limit for every job (HH:MM:SS), and how long a job may sit with
# no VS Code connection before it ends itself.
TIME=12:00:00
IDLE_MINUTES=60

# Job sizes offered under "Start new job", as name:cpus:memory, optionally
# followed by :gpus. GPU jobs run on gpu-short, for at most 2 hours.
PRESETS="single:2:8G double:4:16G pitcher:8:32G shot:4:32G:1"
