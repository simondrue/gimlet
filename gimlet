#!/bin/bash
# gimlet: VS Code jobs on GenomeDK, driven from the SwiftBar menu or the terminal.
#
#   gimlet start <preset>      submit a new job (shot, double, pitcher, ...)
#   gimlet stop <jobid>        cancel a job
#   gimlet stop-all            cancel all your gimlet jobs
#   gimlet open <host> [dir]   open VS Code on gimlet-N (an empty window if no dir is given)
#   gimlet login               log in to GenomeDK (2FA) and keep the connection open
#   gimlet list                show your gimlet jobs
#   gimlet menu                SwiftBar menu output
#   gimlet proxy <host>        ssh ProxyCommand for gimlet-N (used by the generated ssh config)
#   gimlet ssh-config          rewrite the generated ssh config from the settings
#   gimlet doctor              check the setup
#   gimlet update              update gimlet from its git remote
#   gimlet check-update        check its git remote for updates now

set -u -o pipefail

SELF="$(cd "$(dirname "$0")" && pwd -P)/$(basename "$0")"
HERE="$(dirname "$SELF")"
CONF_DIR="$HOME/.config/gimlet"
SETTINGS="$CONF_DIR/settings"
SSH_CONFIG="$CONF_DIR/ssh_config"
SOCKET="$CONF_DIR/login.sock"
LAST_SEEN="$CONF_DIR/state"   # "jobid state warned name" per job, to notice changes between refreshes
STARTING="$CONF_DIR/starting" # preset of a start in progress, shown in the menu until the job is submitted
STOPPING="$CONF_DIR/stopping" # one file per job being stopped, shown in the menu until the stop is done
JOBS="$CONF_DIR/jobs"         # the job list from the last menu refresh
CODE=$(command -v code || echo "/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code")

GREEN="#34C759" ORANGE="#FF9500" GREY="#8E8E93" RED="#FF3B30"

# Takes the menu line and the terminal message.
settings_error() {
    [ "$COMMAND" = menu ] && printf '| sfimage=exclamationmark.circle sfcolor=%s\n---\n%s\n' "$RED" "$1"
    echo "gimlet: $2" >&2
    exit 1
}

COMMAND=${1:-}
KEYS="USERNAME ACCOUNT PARTITION LOGIN_HOST IDENTITY_FILE TIME IDLE_MINUTES PRESETS"
[ -f "$SETTINGS" ] || settings_error "Run install.sh to set up gimlet" "no settings at $SETTINGS; run install.sh"
# Read as plain KEY=value lines, not run as shell code. Values go into remote
# commands, so anything beyond simple characters is refused.
# The || reads a last line that has no newline.
while IFS='=' read -r key value || [ -n "$key" ]; do
    case " $KEYS " in *" $key "*) ;; *) continue ;; esac
    value=${value%[\"\']}; value=${value#[\"\']}
    allowed='^[A-Za-z0-9_.:/~-]*$'
    [ "$key" = PRESETS ] && allowed='^[A-Za-z0-9_.: -]*$'
    [[ $value =~ $allowed ]] || settings_error "Bad $key in settings" "bad $key in $SETTINGS: $value"
    printf -v "$key" '%s' "$value"
done < "$SETTINGS"
for key in $KEYS; do
    [ -n "${!key+set}" ] || settings_error "Missing $key in settings" "no $key line in $SETTINGS (see settings.example)"
done

# Sent through SwiftBar, so the notification shows SwiftBar's icon instead of Script Editor's.
notify() {
    open -g "swiftbar://notify?plugin=gimlet&title=gimlet&subtitle=$(urlencode "$1")&body=$(urlencode "$2")"
}

# Percent-encodes every byte.
urlencode() {
    printf '%s' "$1" | xxd -p | tr -d '\n' | sed 's/../%&/g'
}

# Menu actions run without a terminal, so errors also go to a notification.
die() {
    echo "gimlet: $*" >&2
    [ -t 2 ] || notify "Error ⚠️" "$*"
    exit 1
}

refresh() {
    open -g "swiftbar://refreshplugin?name=gimlet" 2>/dev/null || true
}

# Menu bar pill with a coloured dot, as SwiftBar image params for light and dark menu bars.
# Images are drawn once per text and colour, then reused.
pill() {
    local text=$1 dot=$2 file mode fg images=""
    mkdir -p "$CONF_DIR/icons"
    for mode in light dark; do
        [ $mode = light ] && fg="#1D1D1F" || fg="#FFFFFF"
        file="$CONF_DIR/icons/$(tr ' +' '_p' <<< "$text")-${dot#\#}-$mode.png"
        [ -f "$file" ] || osascript -l JavaScript "$HERE/gimlet-pill.js" "$text" "$dot" "$fg" "$file"
        images="$images${images:+,}$(base64 -i "$file")"
    done
    echo "image=$images"
}

# Takes the running job names. VS Code's host list skips wildcard entries,
# so each running job also gets its own (empty) Host line.
# The file is only replaced when its content changes.
write_ssh_config() {
    local host
    {
    cat <<EOF
# Written by gimlet from $SETTINGS. Edits here are overwritten.

Host gimlet-login
    HostName $LOGIN_HOST
    User $USERNAME
    IdentityFile $IDENTITY_FILE
    ControlMaster auto
    ControlPath $SOCKET
    ControlPersist yes
    ServerAliveInterval 15
    ServerAliveCountMax 3

Host gimlet-* !gimlet-login
    User $USERNAME
    IdentityFile $IDENTITY_FILE
    ProxyCommand "$SELF" proxy %n
    # gimlet-N points at a different node each time, so its host key can't be pinned.
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    LogLevel ERROR
EOF
    for host in $1; do printf '\nHost %s\n' "$host"; done
    } > "$SSH_CONFIG.tmp"
    if cmp -s "$SSH_CONFIG.tmp" "$SSH_CONFIG"; then rm "$SSH_CONFIG.tmp"; else mv "$SSH_CONFIG.tmp" "$SSH_CONFIG"; fi
}

logged_in() {
    ssh -F "$SSH_CONFIG" -O check gimlet-login 2>/dev/null
}

# Runs a command on the login node over the shared connection. Never prompts.
remote() {
    ssh -F "$SSH_CONFIG" -o BatchMode=yes -o ConnectTimeout=10 gimlet-login "$@"
}

# Prints one line per gimlet job, sorted by slot:
#   name|jobid|state|node|timeleft|preset|reason|connection|cpus|mem
# The job comment holds the preset; ~/.gimlet/<jobid> on GenomeDK holds "connected" or
# "idle <minutes>" once the job runs. Files of jobs that are gone (e.g. killed before their
# own cleanup) are removed here; the minute's grace spares a file created just after squeue ran.
# squeue can list other users' jobs despite -u, so the owner is checked here too.
fetch() {
    remote bash -s -- "$USERNAME" <<'REMOTE' |
jobs=$(squeue -u "$1" -h -o '%i|%j|%T|%N|%L|%k|%r|%u|%C|%m') || exit 1
echo "$jobs"
echo ==
for f in ~/.gimlet/*; do
    [ -f "$f" ] || continue
    id=${f##*/}
    if grep -q "^$id|" <<< "$jobs"; then echo "$id $(cat "$f")"
    elif [ -n "$(find "$f" -mmin +1)" ]; then rm -f "$f"; fi
done
REMOTE
        awk -F'|' -v user="$USERNAME" '
            $0 == "==" { status = 1; next }
            status { split($0, a, " "); conn[a[1]] = a[2] == "connected" ? "connected" : a[2] == "idle" ? "idle " a[3] : ""; next }
            $8 == user && $2 ~ /^gimlet-[0-9]+$/ { line[++n] = $2 "|" $1 "|" $3 "|" $4 "|" $5 "|" $6 "|" $7; id[n] = $1; res[n] = $9 "|" $10 }
            END { for (i = 1; i <= n; i++) print line[i] "|" conn[id[i]] "|" res[i] }' |
        sort -t- -k2 -n
}

# Names for the job list's fields in awk, e.g. awk -F'|' "$JOB_FIELDS"' state == "RUNNING" { print name }'
JOB_FIELDS='{ name = $1; id = $2; state = $3; node = $4 }'

# Slurm states by what the menu shows. A job in any other state (COMPLETING, ...) is ending.
WAITING_STATES='PENDING|REQUEUED|REQUEUE_HOLD|REQUEUE_FED|RESV_DEL_HOLD|SPECIAL_EXIT'
RUNNING_STATES='RUNNING|RESIZING'
PAUSED_STATES='SUSPENDED|STOPPED'
CANCELLABLE="$WAITING_STATES|CONFIGURING|$RUNNING_STATES|$PAUSED_STATES"

# Takes a job's state and connection; prints its menu group:
# waiting, open, idle, paused or ending.
group() {
    local state=$1 conn=$2
    if [[ $state =~ ^($WAITING_STATES)$ ]]; then echo waiting
    elif [[ $state =~ ^($RUNNING_STATES)$ ]]; then
        # Waiting until the job's first status note.
        case $conn in connected) echo open ;; idle*) echo idle ;; *) echo waiting ;; esac
    elif [ "$state" = CONFIGURING ]; then echo waiting
    elif [[ $state =~ ^($PAUSED_STATES)$ ]]; then echo paused
    else echo ending
    fi
}

# Keeps the jobs on stdin that can still be cancelled.
cancellable() {
    awk -F'|' -v ok="^($CANCELLABLE)\$" "$JOB_FIELDS"' state ~ ok'
}

# Takes job ids and drops those jobs from the job list on stdin.
drop_jobs() {
    awk -F'|' -v s=" $* " "$JOB_FIELDS"' !index(s, " " id " ")'
}

# Slurm time (MM:SS, HH:MM:SS or D-HH:MM:SS) to seconds.
seconds() {
    local t=$1 d=0 h=0 m=0 s=0 a b c
    # No limit (UNLIMITED) or none known (INVALID): counts as far off.
    [[ $t =~ ^[0-9:-]+$ ]] || { echo 999999999; return; }
    case $t in *-*) d=${t%%-*}; t=${t#*-} ;; esac
    IFS=: read -r a b c <<< "$t"
    if [ -n "$c" ]; then h=$a m=$b s=$c; elif [ -n "$b" ]; then m=$a s=$b; else s=$a; fi
    echo $(( ((d * 24 + 10#$h) * 60 + 10#$m) * 60 + 10#$s ))
}

pretty() {
    local s
    s=$(seconds "$1")
    if [ "$s" -lt 3600 ]; then echo "$((s / 60))m"
    elif [ "$((s % 3600 / 60))" = 0 ]; then echo "$((s / 3600))h"
    else echo "$((s / 3600))h$((s % 3600 / 60))m"; fi
}

# Why a job ended, from Slurm's accounting. A job that ends itself when idle counts as completed.
# Accounting can lag behind the queue, so it asks again for up to a minute.
end_reason() {
    local state
    for _ in 1 2 3 4 5 6; do
        state=$(remote "sacct -j $1 -X -n -P -o State" < /dev/null 2>/dev/null)
        case $state in ""|PENDING*|RUNNING*|COMPLETING*) sleep 10 ;; *) break ;; esac
    done
    # The idle limit is not the setting's: it may have changed since the job started.
    case $state in
        COMPLETED*) echo "No VS Code was connected for its idle limit." ;;
        TIMEOUT*) echo "It reached its time limit." ;;
        OUT_OF_MEMORY*) echo "It ran out of memory. Try a bigger job size." ;;
        CANCELLED*) echo "It was stopped." ;;
        NODE_FAIL*) echo "Its node failed." ;;
        *) echo "The job has ended." ;;
    esac
}

# Notifies when a job leaves the queue, nears its time limit or ends.
notify_changes() {
    local name id state node left rest old warned new=""
    while IFS='|' read -r name id state node left rest; do
        [ -n "$name" ] || continue
        read -r _ old warned _ <<< "$(grep "^$id " "$LAST_SEEN" 2>/dev/null)"
        warned=${warned:-0}
        # Not only PENDING before: a job that starts at once is never seen pending.
        if [ "$old" != RUNNING ] && [ "$state" = RUNNING ]; then
            notify "$name is poured 🍸" "On node $node. Open it from the gimlet menu."
        fi
        if [ "$state" = RUNNING ] && [ "$warned" = 0 ] && [ "$(seconds "$left")" -lt 900 ]; then
            notify "Last call: $name ends in $(pretty "$left") ⏰" "Save your work, the job reaches its time limit soon."
            warned=1
        fi
        new="$new$id $state $warned $name"$'\n'
    done <<< "$1"
    # Any job that had started, not only one seen RUNNING: a refresh can catch it COMPLETING.
    # In the background, as the reason can take a minute to come.
    while read -r id old warned name; do
        [ "$old" != PENDING ] && [ -n "$name" ] && ! grep -q "^$id " <<< "$new" \
            && { notify "$name: tab closed 🧾" "$(end_reason "$id") Cheers!" > /dev/null 2>&1 & }
    done < <(cat "$LAST_SEEN" 2>/dev/null)
    printf '%s' "$new" > "$LAST_SEEN"
}

footer() {
    echo "---"
    echo "Settings… | bash=/usr/bin/open param1=-t param2=\"$SETTINGS\" terminal=false"
    echo "Refresh | refresh=true"
    update_line
    local quotes=("Shaken, not sbatch'd" "Idle nodes are empty glasses"
        "The login node is the designated driver" "Please compute responsibly" "Don't drink and srun"
        "May the cores be with you" "There's no place like ~")
    echo "---"
    # Each quote gets an equal share of the hour.
    echo "${quotes[10#$(date +%M) * ${#quotes[@]} / 60]} | size=11 color=$GREY"
}

# Offers an update when the repo's upstream branch has new commits, else a line to check now. Fetches at most daily, in the background.
update_line() {
    local behind
    git -C "$HERE" rev-parse -q --verify '@{u}' > /dev/null 2>&1 || return
    if [ -z "$(find "$CONF_DIR/update-check" -mtime -1 2>/dev/null)" ]; then
        touch "$CONF_DIR/update-check"
        GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="ssh -o BatchMode=yes" git -C "$HERE" fetch -q < /dev/null > /dev/null 2>&1 &
    fi
    behind=$(behind)
    if [ "${behind:-0}" -gt 0 ]; then
        echo "Update gimlet ($behind new) | bash=\"$SELF\" param1=update terminal=false"
    else
        echo "gimlet is up to date | bash=\"$SELF\" param1=check-update terminal=false color=$GREY tooltip=\"Click to check now\""
    fi
}

# Commits on the repo's upstream branch that are not here yet.
behind() {
    git -C "$HERE" rev-list --count 'HEAD..@{u}' 2>/dev/null
}

# Takes a lock name and the command to run: re-runs gimlet as that command under the lock,
# so only one runs at a time.
one_at_a_time() {
    local lock=$1
    shift
    [ -n "${GIMLET_LOCKED:-}" ] || GIMLET_LOCKED=1 exec lockf -k "$CONF_DIR/$lock.lock" "$SELF" "$@"
}

# The menu when there is no job list: a red pill with its text, then one line.
red_menu() {
    echo "| $(pill "$1" $RED)"
    echo "---"
    echo "$2"
    footer
}

# Ids of jobs being stopped. A mark older than a minute was left by a stop that died.
stopping_ids() {
    find "$STOPPING" -type f -mmin -1 -exec basename {} \; 2>/dev/null | paste -sd' ' -
}

# A job's submenu detail line: grey label, value aligned in a monospace column.
# refresh=true keeps it enabled; macOS draws disabled lines all grey.
detail() {
    printf -- '--\e[90m%-11s\e[0m%s | ansi=true font=Menlo size=11 refresh=true\n' "$1:" "$2"
}

menu() {
    local jobs active running pending starting stopping name id state node left preset reason conn cpus mem p n c m wn wc wm g
    # One menu run at a time, so two quick refreshes don't both see a change and notify twice.
    one_at_a_time menu menu
    [ "$SETTINGS" -nt "$SSH_CONFIG" ] && write_ssh_config ""

    if ! logged_in; then
        red_menu "log in" "Log in to GenomeDK… | bash=\"$SELF\" param1=login terminal=true"
        return
    fi
    # A start or stop in progress; one older than a minute was left by a start or stop that died.
    # Its redraw reuses the last job list, so it shows at once.
    starting=$(find "$STARTING" -mmin -1 -exec cat {} \; 2>/dev/null)
    stopping=$(stopping_ids)
    if [ -n "$starting$stopping" ] && [ -f "$JOBS" ]; then
        jobs=$(cat "$JOBS")
    elif jobs=$(fetch); then
        printf '%s' "$jobs" > "$JOBS"
        notify_changes "$jobs"
        write_ssh_config "$(awk -F'|' "$JOB_FIELDS"' state == "RUNNING" { print name }' <<< "$jobs")"
    else
        red_menu offline "GenomeDK is not answering"
        return
    fi

    # Jobs being stopped or ending are not counted. Waiting ones show as +N.
    active=$(drop_jobs $stopping <<< "$jobs" | cancellable)
    running=0 pending=0
    while IFS='|' read -r name id state node left preset reason conn cpus mem; do
        [ -n "$name" ] || continue
        if [ "$(group "$state" "$conn")" = waiting ]; then pending=$((pending + 1)); else running=$((running + 1)); fi
    done <<< "$active"
    [ -n "$starting" ] && pending=$((pending + 1))
    if [ "$pending" -gt 0 ]; then
        echo "| $(pill "$running +$pending" $ORANGE)"
    elif [ "$running" -gt 0 ]; then
        echo "| $(pill "$running" $GREEN)"
    else
        echo "| $(pill 0 $GREY)"
    fi
    echo "---"

    # Lines with a submenu get a harmless refresh action: SwiftBar 2.1.1 greys out
    # action-less submenu lines when their text changes (swiftbar/SwiftBar#521).
    while IFS='|' read -r name id state node left preset reason conn cpus mem; do
        [ -n "$name" ] || continue
        g=$(group "$state" "$conn")
        case " $stopping " in *" $id "*) g=ending ;; esac
        case $g in
            open|idle)
                if [ "$g" = open ]; then echo "$name · 🍸 Sipping… | refresh=true"
                else echo "$name · 💤 Unused tab (${conn#idle }m) | refresh=true"; fi
                echo "--Open VS Code | bash=\"$SELF\" param1=open param2=$name terminal=false"
                echo "--Stop job | bash=\"$SELF\" param1=stop param2=$id param3=${conn%% *} terminal=false"
                echo "-----"
                detail Preset "$preset"; detail Cores "$cpus"; detail Mem "$mem"; detail Node "$node"; detail "Time left" "$left"; detail "Job ID" "$id"
                ;;
            waiting|paused)
                if [ "$g" = waiting ]; then echo "$name · ⏳ Waiting | refresh=true"
                else echo "$name · ⏸ Paused | refresh=true"; fi
                echo "--Cancel | bash=\"$SELF\" param1=stop param2=$id terminal=false"
                echo "-----"
                detail Preset "$preset"; detail Cores "$cpus"; detail Mem "$mem"
                # A job still in the queue has no node yet, only Slurm's reason for the wait.
                if [ -n "$node" ]; then detail Node "$node"; else detail Waiting "$reason"; fi
                detail "Job ID" "$id"
                ;;
            ending)
                echo "$name · 🧾 Closing tab… | color=$GREY"
                ;;
        esac
    done <<< "$jobs"
    if [ -n "$starting" ]; then
        # The slot submit_script will pick: the lowest free one in the last job list.
        n=1
        while grep -q "^gimlet-$n|" <<< "$jobs"; do n=$((n + 1)); done
        echo "gimlet-$n · ⏳ Waiting | refresh=true"
    fi
    [ -n "$jobs$starting" ] && echo "---"
    # The submenu is the confirmation.
    if [ -n "$active" ]; then
        n=$(grep -c . <<< "$active")
        echo "Stop all jobs? | refresh=true"
        if [ "$n" = 1 ]; then n="1 job"; else n="$n jobs"; fi
        echo "--Yes, stop $n | bash=\"$SELF\" param1=stop-all terminal=false"
        echo "---"
    fi

    # Greyed out (no action) while a job is waiting: it may have no node yet, so a new
    # job can't be kept off it. start refuses too, in case this menu is out of date.
    if [ "$pending" -gt 0 ]; then
        echo "Start new job (after the waiting one starts)"
    else
        echo "Start new job | refresh=true"
        # One line per size: its name, then its details in grey, in columns like a job's details.
        wn=0 wc=0 wm=0
        for p in $PRESETS; do
            IFS=: read -r n c m <<< "$p"
            [ "${#n}" -gt "$wn" ] && wn=${#n}; [ "${#c}" -gt "$wc" ] && wc=${#c}; [ "${#m}" -gt "$wm" ] && wm=${#m}
        done
        for p in $PRESETS; do
            IFS=: read -r n c m <<< "$p"
            printf -- '--%-*s  \e[90m%*s cores · %*s · %s\e[0m | ansi=true font=Menlo bash="%s" param1=start param2=%s terminal=false\n' \
                "$wn" "$n" "$wc" "$c" "$wm" "$m" "$(pretty "$TIME")" "$SELF" "$n"
        done
    fi
    footer
}

# Run on the login node by start: submits gimlet-job.sh to the lowest free slot and prints "gimlet-N jobid".
submit_script() {
    cat <<'REMOTE'
set -o pipefail
user=$1 args=$2
jobs=$(squeue -u "$user" -h -o '%j|%T|%N|%u' | awk -F'|' -v u="$user" '$4 == u && $1 ~ /^gimlet-[0-9]+$/') || exit 1
# A waiting job has no node yet, so --exclude can't keep a new job off its node.
waiting=$(awk -F'|' '$3 == "" { print $1; exit }' <<< "$jobs")
[ -z "$waiting" ] || { echo "$waiting is still waiting for a node; start another once it runs." >&2; exit 1; }
slot=1
while grep -q "^gimlet-$slot|" <<< "$jobs"; do slot=$((slot + 1)); done
# Keep jobs on separate nodes, so each job's idle check only sees its own connections.
exclude=$(awk -F'|' '$3 != "" { print $3 }' <<< "$jobs" | paste -sd, -)
id=$(sbatch $args --job-name=gimlet-$slot ${exclude:+--exclude=$exclude} <<'GIMLET_JOB'
REMOTE
    cat "$HERE/gimlet-job.sh"
    cat <<'REMOTE'
GIMLET_JOB
) || exit 1
# The status file lets wait_start see the job's first write at once. Only created, never
# emptied: a job that starts at once may have written to it already.
mkdir -p ~/.gimlet && touch ~/.gimlet/$id && echo "gimlet-$slot $id"
REMOTE
}

start() {
    local preset=${1:-} spec="" p cpus mem args out id
    for p in $PRESETS; do [ "${p%%:*}" = "$preset" ] && spec=$p; done
    [ -n "$spec" ] || die "unknown preset '$preset' (settings has: $PRESETS)"
    IFS=: read -r _ cpus mem <<< "$spec"
    # One start at a time, so two quick clicks don't pick the same slot.
    one_at_a_time start start "$preset"
    # Show the start at once; submitting takes a few seconds. The note goes when start ends, but its
    # drawn line stays until the next redraw (wait_start's when the job runs, or the next refresh).
    # Only a failed start redraws at once.
    echo "$preset" > "$STARTING"
    trap 'rc=$?; rm -f "$STARTING"; [ "$rc" = 0 ] || refresh' EXIT
    refresh

    logged_in || die "not logged in to GenomeDK, run: gimlet login"
    args="--parsable --comment=$preset --account=$ACCOUNT --time=$TIME"
    args="$args --cpus-per-task=$cpus --mem=$mem --output=/dev/null --export=ALL,IDLE_MINUTES=$IDLE_MINUTES"
    [ -n "$PARTITION" ] && args="$args --partition=$PARTITION"
    # Picking the slot and submitting happen in one call: each ssh command costs seconds on a busy login node.
    out=$(submit_script | remote bash -s -- "$USERNAME" "'$args'" 2>&1) || die "could not start a job: $out"
    echo "Submitted $out"
    id=${out##* }
    wait_start "$id" < /dev/null > /dev/null 2>&1 &
}

# Waits for a new job to start without asking Slurm: the job writes its status into the file
# created at submit time (cat opens it, which makes the login node re-check it). Ends when the
# file is gone (job stopped) or after an hour, leaving the rest to the menu's own refresh.
wait_start() {
    remote "f=~/.gimlet/$1; for i in \$(seq 720); do [ -e \$f ] || exit; [ -n \"\$(cat \$f)\" ] && exit; sleep 5; done"
    refresh
}

stop() {
    local id=${1:-} conn=${2:-}
    [[ $id =~ ^[1-9][0-9]*$ ]] || die "usage: gimlet stop <jobid>"
    # Only ever cancel our own gimlet jobs. Checked against the last job list, so the stop needs no extra ssh call.
    awk -F'|' -v want="$id" "$JOB_FIELDS"' id == want { found = 1 } END { exit !found }' "$JOBS" 2>/dev/null \
        || die "job $id is not one of your gimlet jobs"
    if [ "$conn" = connected ]; then
        osascript -e 'display dialog "A VS Code window is connected to this job. Stop it anyway?" buttons {"Cancel", "Stop job"} default button "Cancel" with icon caution' >/dev/null || exit 0
    fi
    cancel "$id"
}

stop_all() {
    local ids
    # Jobs already being stopped or ending are left out.
    ids=$(drop_jobs $(stopping_ids) 2>/dev/null < "$JOBS" | cancellable | awk -F'|' "$JOB_FIELDS"' { print id }' | paste -sd' ' -)
    [ -n "$ids" ] || die "you have no gimlet jobs"
    cancel $ids
}

# Takes job ids and cancels them. They show as stopping at once; the marks go when this ends,
# and the menu then asks GenomeDK.
cancel() {
    local out
    mkdir -p "$STOPPING"
    (cd "$STOPPING" && touch "$@")
    trap "(cd '$STOPPING' && rm -f $*); refresh" EXIT
    refresh
    out=$(remote "scancel -u $USERNAME $* && rm -f$(printf ' ~/.gimlet/%s' "$@")" 2>&1) || die "could not stop job $*: $out"
    # Drops them from the last job list, so a redraw that reuses it (while a start is in progress) doesn't count them again.
    drop_jobs "$@" < "$JOBS" > "$JOBS.tmp" && mv "$JOBS.tmp" "$JOBS"
}

open_vscode() {
    local host=${1:-} dir=${2:-}
    [ -n "$host" ] || die "usage: gimlet open <gimlet-N> [folder]"
    if [ -n "$dir" ]; then
        "$CODE" --remote "ssh-remote+$host" "$dir"
    else
        # An empty window on the node, where File > Open Folder browses GenomeDK.
        "$CODE" --new-window --remote "ssh-remote+$host"
    fi
}

login() {
    echo "Logging in to $LOGIN_HOST as $USERNAME. Enter your 2FA code if asked."
    ssh -F "$SSH_CONFIG" gimlet-login true || exit 1
    echo "Logged in. You can close this window."
    refresh
}

# ProxyCommand for gimlet-N: finds the node of that slot's running job and connects to it.
proxy() {
    local host=${1:-} jobs node
    logged_in || die "not logged in to GenomeDK. Use 'Log in to GenomeDK' in the gimlet menu."
    # stdin is the connection being proxied, so the lookup must not read from it.
    jobs=$(fetch < /dev/null) || die "GenomeDK is not answering"
    node=$(awk -F'|' -v h="$host" "$JOB_FIELDS"' name == h && state == "RUNNING" { print node; exit }' <<< "$jobs")
    [ -n "$node" ] || die "$host has no running job. Start one from the gimlet menu."
    exec ssh -F "$SSH_CONFIG" -o BatchMode=yes -W "$node:22" gimlet-login
}

update() {
    local out
    out=$(git -C "$HERE" pull -q --ff-only 2>&1) || die "could not update: $out"
    notify "Updated ✨" "gimlet is up to date."
    refresh
}

check_update() {
    local out behind
    touch "$CONF_DIR/update-check"
    out=$(git -C "$HERE" fetch -q 2>&1) || die "could not check for updates: $out"
    behind=$(behind)
    if [ "$behind" -gt 0 ]; then
        notify "Update available ✨" "$behind new. Choose Update gimlet in the menu."
    else
        notify "Up to date ✨" "gimlet has no updates."
    fi
    refresh
}

# Checks each part of the setup and says how to fix what is missing.
doctor() {
    local plugins failed=0
    check() {
        local label=$1 hint=$2
        shift 2
        if "$@" > /dev/null 2>&1; then echo "✓ $label"; else echo "✗ $label: $hint"; failed=1; fi
    }
    plugins=$(defaults read com.ameba.SwiftBar PluginDirectory 2>/dev/null)
    plugins=${plugins/#\~/$HOME}

    check "username and account set" "fill in USERNAME and ACCOUNT in $SETTINGS" test -n "$USERNAME" -a -n "$ACCOUNT"
    check "ssh key $IDENTITY_FILE" "create one with ssh-keygen, or set IDENTITY_FILE in $SETTINGS" test -f "${IDENTITY_FILE/#\~/$HOME}"
    # ssh reads an Include after a Host line as part of that host.
    check "gimlet's ssh config included" "put 'Include $SSH_CONFIG' at the top of ~/.ssh/config (install.sh does this)" \
        awk -v inc="Include $SSH_CONFIG" '$0 == inc { found = 1; exit } tolower($1) ~ /^(host|match)$/ { exit } END { exit !found }' ~/.ssh/config
    check "VS Code" "install Visual Studio Code in /Applications" test -x "$CODE"
    check "VS Code Remote-SSH extension" "install 'Remote - SSH' in VS Code" grep -qix ms-vscode-remote.remote-ssh <("$CODE" --list-extensions 2>/dev/null)
    check "menu bar plugin" "run install.sh" grep -qF "$SELF" "$plugins/gimlet.2m.sh"
    check "SwiftBar running" "open SwiftBar" pgrep -x SwiftBar
    check "logged in to GenomeDK" "run: gimlet login" logged_in
    if logged_in; then
        check "Slurm account $ACCOUNT" "not one of your accounts; fix ACCOUNT in $SETTINGS" \
            grep -qix "$ACCOUNT" <(remote "sacctmgr -n -P show assoc where user=$USERNAME format=account")
    fi
    return $failed
}

list() {
    logged_in || die "not logged in to GenomeDK, run: gimlet login"
    fetch | column -t -s '|'
}

case ${1:-} in
    start) start "${2:-}" ;;
    stop) stop "${2:-}" "${3:-}" ;;
    stop-all) stop_all ;;
    open) open_vscode "${2:-}" "${3:-}" ;;
    login) login ;;
    list) list ;;
    menu) menu ;;
    proxy) proxy "${2:-}" ;;
    ssh-config) write_ssh_config "" ;;
    doctor) doctor ;;
    update) update ;;
    check-update) check_update ;;
    *) sed -n '2,16s/^# \{0,1\}//p' "$SELF"; exit 1 ;;
esac
